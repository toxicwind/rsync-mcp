#!/usr/bin/env bash
# rsync-mcp — self-test gate (PASS/FAIL).
# Exercises the MCP stdio protocol + security refusals (delete-flag, path escape).
# Verifies tools/list inventory and that dangerous operations are refused.
# Deliberately set +e around captures so the estate run-fast shim cannot abort us mid-report.
cd "$(dirname "$0")/.."

echo "== rsync-mcp check: start =="
fail=0

if ! command -v bun >/dev/null 2>&1; then
  echo "FAIL: bun not found (smoke.ts requires bun)"
  exit 1
fi

if ! node --check index.js; then
  echo "FAIL: index.js syntax error"
  exit 1
fi

set +e
out="$(bun run smoke.ts 2>&1)"
rc=$?
set -e
echo "$out"

[ "$rc" -eq 0 ] && [ -n "$out" ] || { echo "FAIL: smoke run returned rc=$rc or no output"; exit 1; }
echo "$out" | grep -q "SMOKE_DONE" || { echo "FAIL: SMOKE_DONE missing"; exit 1; }
echo "$out" | grep -q "delete-no-confirm: REFUSED" || { echo "FAIL: delete-without-confirm guard not engaging"; exit 1; }
echo "$out" | grep -q "path-escape: REFUSED" || { echo "FAIL: path-escape guard not engaging"; exit 1; }
echo "$out" | grep -q "local-escape: REFUSED" || { echo "FAIL: local-escape guard not engaging"; exit 1; }

echo "== rsync-mcp check: PASS =="
exit 0